[project]
# Python项目无需node，删除node依赖

[dev]
# 数组拆分参数，不带bash嵌套
build = ["python", "-m", "pip", "install", "-r", "requirements.txt"]
# 注意：数组项不做shell展开，端口必须用 sh -c 才能读取 ${DEPLOY_RUN_PORT}
run = ["sh", "-c", "python -m uvicorn app:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT:-5000}"]

[deploy]
build = ["python", "-m", "pip", "install", "-r", "requirements.txt"]
# 与 b4842e8 一致：裸数组形式，vefaas 平台实测可正常部署（端口变量由平台 shell 展开）
run = [
    "python", "-m", "uvicorn",
    "app:app",
    "--host", "0.0.0.0",
    "--port", "${DEPLOY_RUN_PORT:-5000}",
    "--log-level", "info"
]
