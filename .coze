[project]
# Python项目无需node，删除node依赖

[dev]
# 数组拆分参数，不带bash嵌套
build = ["python", "-m", "pip", "install", "-r", "requirements.txt"]
# 注意：数组项不做shell展开，端口必须用 sh -c 才能读取 ${DEPLOY_RUN_PORT}
run = ["sh", "-c", "python -m uvicorn app:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT:-5000}"]

[deploy]
build = ["python", "-m", "pip", "install", "-r", "requirements.txt"]
# ⚠️ 数组项不做 shell 展开：${DEPLOY_RUN_PORT:-5000} 会以字面量传给 --port，实测报 Invalid value 启动失败
# 若部署失败，请改回可用版本：
# run = ["sh", "-c", "exec python -m uvicorn app:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT:-5000} --log-level info"]
run = [
    "python", "-m", "uvicorn",
    "app:app",
    "--host", "0.0.0.0",
    "--port", "${DEPLOY_RUN_PORT:-5000}",
    "--log-level", "info"
]
