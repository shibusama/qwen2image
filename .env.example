# 千问 API Key
# 海外千问 AI 平台：https://platform.qianwenai.com/home/api-keys 创建 Key
# 阿里云百炼（大陆站）：https://bailian.console.aliyun.com 创建 Key
# 复制本文件为 .env 并填入你的 Key
DASHSCOPE_API_KEY=sk-xxx

# API 地址：海外千问平台填下面这行；大陆百炼留空（用默认）即可
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# 摘要模型（默认 qwen-plus，可按需切换，如 qwen-max / qwen-turbo）
# SUMMARY_MODEL=qwen-plus

# 生图模型（默认 qwen-image-3.0-pro，推荐 qwen-image-max 最强）
# IMAGE_MODEL=qwen-image-3.0-pro
